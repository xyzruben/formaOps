# Database
DATABASE_URL="postgresql://formaops:password@localhost:5432/formaops_dev"

# Authentication (Supabase)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# AI Integration
OPENAI_API_KEY="sk-your-key-here"
OPENAI_DEFAULT_MODEL="gpt-3.5-turbo"
OPENAI_MAX_TOKENS="2000"
OPENAI_TEMPERATURE="0.7"

# Cost tracking
GPT35_COST_PER_1K_INPUT="0.0015"
GPT35_COST_PER_1K_OUTPUT="0.002"
GPT4_COST_PER_1K_INPUT="0.03"
GPT4_COST_PER_1K_OUTPUT="0.06"

# Application
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret"

# Cron Jobs
CRON_SECRET="your-cron-secret-here"

# Production URL (for Vercel deployment)
NEXT_PUBLIC_APP_URL="https://forma-ops.vercel.app"

# Upstash Redis (for distributed rate limiting - Section 2.2: security_dog.md)
# Sign up at https://upstash.com and create a Redis database
# Required for production serverless deployments (falls back to in-memory in dev if not set)
UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-token-here"

# Field-level encryption (Section 4.1: security_dog.md)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REQUIRED for production to encrypt sensitive data at rest
ENCRYPTION_KEY="your-64-character-hex-string-here"

# Development
NODE_ENV="development"