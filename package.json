{
  "name": "formaops",
  "version": "0.1.0",
  "private": true,
  "description": "AI-native prompt management platform for developers",
  "scripts": {
    "setup": "npm install && npm run env:setup && npm run db:setup",
    "env:setup": "cp .env.example .env.local",
    "db:setup": "docker-compose up -d && npx prisma db push && npx prisma db seed",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate && next build",
    "lint": "eslint . --ext .ts,.tsx --fix",
    "lint:check": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "analyze": "ANALYZE=true npm run build",
    "db:migrate": "npx prisma db push",
    "db:seed": "npx prisma db seed",
    "db:reset": "npx prisma migrate reset --force",
    "db:studio": "npx prisma studio",
    "config:check": "node scripts/check-config.js",
    "validate-production": "docker run --rm -v $(pwd):/app -w /app node:20-alpine sh -c 'npm ci --omit=dev && npm run build'",
    "validate-production-local": "rm -rf node_modules && npm ci --omit=dev && npm run build && npm install",
    "emergency-format": "npm run format && git add -A && git commit -m 'fix: resolve formatting violations' && git push",
    "quick-health-check": "npm run type-check && npm run lint:check && npm run format:check && npm test -- --passWithNoTests",
    "pre-merge": "./scripts/pre-merge-validation.sh",
    "audit-dependencies": "npm audit --audit-level=high && npm outdated",
    "validate-classifications": "npm ci --omit=dev && npm run build && npm install",
    "monthly-health-check": "npm run audit-dependencies && npm run validate-classifications && npm run quick-health-check",
    "drift-check": "./scripts/environment-drift-check.sh",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.2",
    "@prisma/client": "^5.7.0",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-toast": "^1.1.5",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.54.0",
    "autoprefixer": "^10.4.16",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "date-fns": "^3.0.0",
    "lucide-react": "^0.294.0",
    "next": "^15.0.0",
    "openai": "^4.24.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.48.2",
    "tailwind-merge": "^2.2.0",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "5.9.2",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@playwright/test": "^1.40.0",
    "@testing-library/jest-dom": "^6.7.0",
    "@testing-library/react": "14.3.1",
    "@testing-library/user-event": "14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.10.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.2",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "eslint": "^9.33.0",
    "eslint-config-next": "^15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "husky": "^9.1.7",
    "isomorphic-dompurify": "^2.6.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^16.1.5",
    "postcss": "^8.4.32",
    "prettier": "^3.1.1",
    "prisma": "^5.7.0",
    "tailwindcss": "^3.4.0",
    "webpack-bundle-analyzer": "^4.9.1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  }
}
